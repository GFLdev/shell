[global]

### geometry
width = 320
height = 300
origin = top-right
offset = 20x20
gap_size = 8

### transparency
transparency = 0

### appearance
corner_radius = 4
padding = 16
horizontal_padding = 16
frame_width = 2
separator_height = 1

### font
font = Iosevka Nerd Font Mono 11

### markup
markup = full
format = <b>%s</b>\n%b

### icons
enable_recursive_icon_lookup = true
icon_theme = Papirus-Dark

### behavior
follow = mouse
indicate_hidden = yes
stack_duplicates = true
hide_duplicate_count = false
show_age_threshold = 60
word_wrap = yes
ellipsize = middle
ignore_newline = no
sort = yes

### history
history_length = 20

### progress bar
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 0
progress_bar_min_width = 150
progress_bar_max_width = 300

### misc
browser = firefox
always_run_script = true
title = Dunst
class = Dunst

### urgency

[urgency_low]
background = "#050505"
foreground = "#808080"
frame_color = "#404040"
highlight = "#404040"
timeout = 3

[urgency_normal]
background = "#050505"
foreground = "#c0c0c0"
frame_color = "#808080"
highlight = "#808080"
timeout = 6

[urgency_critical]
background = "#111111"
foreground = "#ffffff"
frame_color = "#ffffff"
highlight = "#ffffff"
timeout = 0
